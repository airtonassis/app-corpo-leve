{
  "expo": {
    "name": "Corpo Leve",
    "slug": "app-corpo-leve",
    "scheme": "forcaleve",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.forcaleve.app"
    },
    "android": {
      "package": "com.forcaleve.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F2"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8A9A5B"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c092e037-c9b5-40af-a942-246b5637d412"
      }
    },
    "owner": "araservice"
  }
}
