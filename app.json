{
  "expo": {
    "name": "Força Leve",
    "slug": "app-corpo-leve",
    "scheme": "forcaleve",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.forcaleve.app"
    },

    "android": {
      "package": "com.forcaleve.app"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F2"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8A9A5B"
        }
      ]
    ]
  }
}